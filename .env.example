# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" (con datos reales) a un repositorio.

# --- Conexión a SQL Server ---
MSSQL_HOST=
MSSQL_PORT=1433
# Instancia con nombre (opcional). Ej: SQLEXPRESS. Si se indica, se conecta a HOST\INSTANCIA
# y se ignora el puerto (el SQL Browser resuelve el puerto dinámico).
MSSQL_INSTANCE=
# Base de datos por defecto (opcional; si se deja vacío usa la default del login)
MSSQL_DATABASE=

# Autenticación: SQL Server Auth (usuario/password) ...
MSSQL_USER=
MSSQL_PASSWORD=
# ... o autenticación integrada de Windows (ignora usuario/password si es true)
MSSQL_TRUSTED_CONNECTION=false

# --- Driver ODBC ---
# Déjalo vacío para autodetectar el "ODBC Driver NN for SQL Server" más nuevo instalado.
MSSQL_ODBC_DRIVER=
# Cifrado de la conexión. Driver 18 exige cifrado por defecto.
MSSQL_ENCRYPT=true
# true si el servidor usa un certificado autofirmado (típico en entornos de desarrollo/legacy)
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- Política de la utilidad ---
# true = solo se permiten sentencias SELECT (recomendado)
READ_ONLY=true
# Máximo de filas que se devuelven por consulta
MAX_ROWS=200
# Timeout de la consulta en segundos
QUERY_TIMEOUT_SECONDS=30
